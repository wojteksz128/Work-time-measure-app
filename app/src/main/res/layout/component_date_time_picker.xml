<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />

        <variable
            name="model"
            type="net.wojteksz128.worktimemeasureapp.util.view.DateTimePicker.ObservableModel" />
    </data>

    <merge
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout_height="wrap_content">

            <NumberPicker
                android:id="@+id/date_time_picker_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onValueChange="@{(view, oldValue, newValue) -> model.setHour(newValue)}"
                app:layout_constraintBottom_toTopOf="@id/date_time_picker_select_date"
                app:layout_constraintEnd_toStartOf="@id/date_time_picker_minute"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/date_time_picker_minute"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:maxValue="@{model.is24HourFormat() ? 23 : 12}"
                app:minValue="@{model.is24HourFormat() ? 0 : 1}"
                app:value="@{model.hour}"
                tools:maxValue="23"
                tools:minValue="0"
                tools:value="0" />

            <NumberPicker
                android:id="@+id/date_time_picker_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onValueChange="@{(view, oldValue, newValue) -> model.setMinute(newValue)}"
                app:layout_constraintBottom_toTopOf="@id/date_time_picker_select_date"
                app:layout_constraintEnd_toStartOf="@id/date_time_picker_second"
                app:layout_constraintLeft_toRightOf="@id/date_time_picker_hour"
                app:layout_constraintRight_toLeftOf="@id/date_time_picker_second"
                app:layout_constraintStart_toEndOf="@id/date_time_picker_hour"
                app:layout_constraintTop_toTopOf="parent"
                app:maxValue="@{59}"
                app:minValue="@{0}"
                app:value="@{model.minute}"
                tools:maxValue="59"
                tools:minValue="0"
                tools:value="0" />

            <NumberPicker
                android:id="@+id/date_time_picker_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onValueChange="@{(view, oldValue, newValue) -> model.setSecond(newValue)}"
                app:layout_constraintBottom_toTopOf="@id/date_time_picker_select_date"
                app:layout_constraintEnd_toStartOf="@id/date_time_picker_am_pm_block"
                app:layout_constraintLeft_toRightOf="@id/date_time_picker_minute"
                app:layout_constraintRight_toLeftOf="@id/date_time_picker_am_pm_block"
                app:layout_constraintStart_toEndOf="@id/date_time_picker_minute"
                app:layout_constraintTop_toTopOf="parent"
                app:maxValue="@{59}"
                app:minValue="@{0}"
                app:value="@{model.second}"
                tools:maxValue="59"
                tools:minValue="0"
                tools:value="0" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/date_time_picker_am_pm_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="@{model.is24HourFormat() ? View.GONE : View.VISIBLE }"
                app:layout_constraintBottom_toTopOf="@id/date_time_picker_select_date"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toRightOf="@id/date_time_picker_second"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toEndOf="@id/date_time_picker_second"
                app:layout_constraintTop_toTopOf="parent">

                <ToggleButton
                    android:id="@+id/date_time_picker_am"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/default_margin"
                    android:checked="@{model.isAm}"
                    android:onClick="@{() -> model.onAmClick()}"
                    android:textOff="@string/work_day_details_come_events_action_edit_am_label"
                    android:textOn="@string/work_day_details_come_events_action_edit_am_label"
                    app:layout_constraintBottom_toTopOf="@id/date_time_picker_pm"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:checked="true" />

                <ToggleButton
                    android:id="@+id/date_time_picker_pm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/default_margin"
                    android:checked="@{model.isPm}"
                    android:onClick="@{() -> model.onPmClick()}"
                    android:textOff="@string/work_day_details_come_events_action_edit_pm_label"
                    android:textOn="@string/work_day_details_come_events_action_edit_pm_label"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/date_time_picker_am"
                    tools:checked="false" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <CheckBox
                android:id="@+id/date_time_picker_select_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="@{model.isSelectDate}"
                android:onClick="@{() -> model.onSelectDateClick()}"
                android:text="@string/work_day_details_come_events_action_edit_select_date_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/date_time_picker_hour" />

            <NumberPicker
                android:id="@+id/date_time_picker_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onValueChange="@{(view, oldValue, newValue) -> model.setYear(newValue)}"
                android:visibility="@{model.isSelectDate ? View.GONE : View.VISIBLE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/date_time_picker_month"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/date_time_picker_month"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/date_time_picker_select_date"
                app:maxValue="@{model.currentYear}"
                app:minValue="@{model.minYear}"
                app:value="@{model.year}"
                tools:maxValue="2018"
                tools:minValue="1970"
                tools:value="2018" />

            <NumberPicker
                android:id="@+id/date_time_picker_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onValueChange="@{(view, oldValue, newValue) -> model.setMonth(newValue)}"
                android:visibility="@{model.isSelectDate ? View.GONE : View.VISIBLE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/date_time_picker_day"
                app:layout_constraintLeft_toRightOf="@id/date_time_picker_year"
                app:layout_constraintRight_toLeftOf="@id/date_time_picker_day"
                app:layout_constraintStart_toEndOf="@id/date_time_picker_year"
                app:layout_constraintTop_toBottomOf="@id/date_time_picker_select_date"
                app:maxValue="@{12}"
                app:minValue="@{1}"
                app:value="@{model.month}"
                tools:maxValue="12"
                tools:minValue="1"
                tools:value="0" />

            <NumberPicker
                android:id="@+id/date_time_picker_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onValueChange="@{(view, oldValue, newValue) -> model.setDay(newValue)}"
                android:visibility="@{model.isSelectDate ? View.GONE : View.VISIBLE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toRightOf="@id/date_time_picker_month"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toEndOf="@id/date_time_picker_month"
                app:layout_constraintTop_toBottomOf="@id/date_time_picker_select_date"
                app:maxValue="@{model.maxMonthDay}"
                app:minValue="@{1}"
                app:value="@{model.day}"
                tools:maxValue="31"
                tools:minValue="1"
                tools:value="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </merge>
</layout>